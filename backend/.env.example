# MongoDB connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=jacksonville_programs

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# AI-powered search (optional). Falls back to keyword search if unset/invalid.
OPENAI_API_KEY=

# Unused: stripe is listed in requirements.txt but no Stripe integration
# exists yet in server.py. Not required to run the app as-is.
# STRIPE_API_KEY=
